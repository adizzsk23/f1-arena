{
  "name": "inovx-grand-prix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:driver": "pnpm --filter @gx/driver dev",
    "build:driver": "pnpm --filter @gx/driver build",
    "harness": "tsx tools/harness/src/main.ts",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "trackgen": "tsx tools/harness/src/trackgen.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/node": "22.9.0",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vitest": "2.1.5"
  }
}
